#include <stdio.h>
int main () 
{
int i, j;
int A[10][10],  B[10][10], C[10][10];
int m, n, p, q, k;
//Input the Dimensions of Matrix A
printf("Enter the Rows and Coloumn for Matrix A(m x n):");
scanf("%d%d", &m, &n);
//Input the Dimensions of Matrix B 
printf("Enter the Rows and Coloumn for Matrix B(p x q):");
scanf("%d%d", &p, &q);
//Conditions of Matrix A&B
if(n == p)
//Read Matrix A
printf("\nEnter the values for Matrix (%d & %d):\n", m, n);
for(i=0; i<m; i++)
{
    for(j=0; j<n; j++)
    {
        scanf("%d", &A[i][j]);
    }
}
//Read Matrix B
printf("\nEnter the values for Matrix (%d & %d):\n", p, q);
for(i=0;i<p; i++)
{
    for(j=0; j<q; j++)
    { 
        scanf("%d", &B[i][j]);
    }
    
}
//Multiply Matrices A & B assinged that to C
//Here the Matrix are the order of row-(m) & coloumn-(q)
for(i=0; i<m; i++)
{
    for(j=0; j<q; j++)
    {
        for (k = 0; k < n; k++)
            {
                C[i][j] = C[i][j] + A[i][k] * B[k][j];
            }
    }
}
//Print Matrix A
for(i=0; i<m; i++)
{
    for(j=0; j<n; j++)
    {
        printf("%d\t", A[i][j]);
    }
